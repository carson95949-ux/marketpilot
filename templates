{% extends "base.html" %}
{% block title %}My Account · MarketPilot{% endblock %}
{% block body %}
<main class="account-page">
  <header class="tool-header compact-header"><a class="brand" href="/"><span class="brand-mark">M</span><span>MarketPilot</span></a><div class="header-right">{% if access %}<a class="btn btn-secondary btn-small" href="/tool">Open Tool</a>{% endif %}<form method="post" action="/logout"><button class="header-link ghost-button">Sign out</button></form></div></header>

  <section class="account-hero panel compact-account-hero"><div><span class="kicker">MY ACCOUNT</span><h1>{{ user.email }}</h1><p class="muted">Everything important, separated into three simple tabs.</p></div><div class="account-status-card"><span>ACCESS</span>{% if access and access.kind=='purchase' %}<strong class="positive">LIFETIME UNLOCKED</strong>{% elif access and access.kind=='trial' %}<strong>FREE TRIAL ACTIVE</strong><small>{{ access.remaining_seconds // 60 }} min remaining</small>{% elif trial.expired %}<strong class="amber">TRIAL ENDED</strong>{% else %}<strong>NO ACTIVE ACCESS</strong>{% endif %}</div></section>
  {% if not access %}<section class="purchase-strip"><div><strong>Unlock MarketPilot for {{ price }}</strong><span>One payment. Lifetime access.</span></div><a class="btn btn-primary" href="/purchase">Buy MarketPilot</a></section>{% endif %}

  <nav class="section-tabs account-tabs" data-tab-group="account" aria-label="Account sections">
    <button class="section-tab active" type="button" data-tab-target="overview">Overview</button>
    <button class="section-tab" type="button" data-tab-target="polymarket">Polymarket</button>
    <button class="section-tab" type="button" data-tab-target="rankings">Rankings</button>
  </nav>

  <div class="tab-pane active" data-tab-pane="overview">
    <section class="account-two-col simplified-account-grid">
      <article class="panel"><span class="kicker">PERSONAL ACCOUNT</span><h2>Access & login</h2><div class="account-list"><div><span>Email</span><strong>{{ user.email }}</strong></div><div><span>Free trial</span><strong>{% if trial.active %}Active{% elif trial.started %}Used{% else %}Available{% endif %}</strong></div><div><span>Purchase</span><strong>{% if user.purchased %}Paid{% else %}Not purchased{% endif %}</strong></div></div>{% if not trial.started and not user.purchased %}<a class="btn btn-secondary btn-wide" href="/trial">Start 30-minute free trial</a>{% endif %}</article>
      <article class="panel quick-account-actions"><span class="kicker">QUICK ACTIONS</span><h2>Where do you want to go?</h2><div class="quick-action-stack">{% if access %}<a class="btn btn-primary btn-wide" href="/tool">Open MarketPilot</a>{% endif %}<button class="btn btn-secondary btn-wide" type="button" data-open-tab="polymarket">Connect Polymarket</button><button class="btn btn-secondary btn-wide" type="button" data-open-tab="rankings">View Rankings</button></div></article>
    </section>
    <section class="panel security-mini"><span class="kicker">SECURITY</span><p>MarketPilot stores only a separate encrypted trading session signer. Never paste your main wallet owner key into this site.</p></section>
  </div>

  <div id="polymarket" class="tab-pane" data-tab-pane="polymarket">
    <section class="panel poly-account-emphasis focused-panel"><div class="poly-account-top"><div><span class="kicker">POLYMARKET TRADING ACCOUNT</span><h2>Connect trading access</h2></div><span class="secure-pill">TRADING ONLY</span></div><p class="muted">Connect with a scoped Session Key. Your main wallet private key never goes into MarketPilot.</p>{% if not access %}<div class="notice">Start a trial or unlock MarketPilot first.</div>{% else %}<div id="poly-connect-app" data-builder-ready="{{ 'true' if builder_configured else 'false' }}"><div class="connection-panel compact-connection"><div><span class="step-label">STATUS</span><h2 id="connection-status">Checking…</h2><p id="connection-detail">Reading connection state.</p></div><div class="session-id-box"><span>Session signer</span><strong id="session-address">—</strong></div></div>{% if not builder_configured %}<div class="notice warning-notice"><strong>Owner setup required.</strong> Add your Polymarket Builder credentials to the server <code>.env</code>.</div>{% endif %}<div class="connect-simple"><button id="connect-wallet" class="btn btn-secondary">1. Connect MetaMask / Rabby</button><div class="mini-row"><span>Owner wallet</span><strong id="owner-address">—</strong></div><label class="field-label">2. Polymarket Deposit Wallet</label><input id="deposit-wallet" class="text-input" placeholder="0x…"><p class="field-help">Copy your account wallet address from Polymarket.</p><button id="authorize-session" class="btn btn-primary btn-wide" disabled>3. Authorize trading-only connection</button><button id="revoke-session" class="btn btn-danger btn-wide" hidden>Disconnect & revoke</button></div></div>{% endif %}</section>
  </div>

  <div id="rankings" class="tab-pane" data-tab-pane="rankings">
    <section class="panel leaderboard-panel focused-panel"><div class="panel-heading"><div><span class="kicker">COMMUNITY RANK</span><h2>Your MarketPilot performance rank</h2><p class="muted">The leaderboard is always visible. Members can choose whether to publish their own paper stats. Ranking uses normalized paper ROI—not wager size.</p></div>{% if leaderboard.current and leaderboard.current.rank %}<div class="rank-badge">#{{ leaderboard.current.rank }}</div>{% else %}<div class="rank-badge muted-rank">—</div>{% endif %}</div>
            {% if saved %}<div class="notice positive-notice">Leaderboard settings saved.</div>{% endif %}{% if leaderboard_error %}<div class="notice error">{{ leaderboard_error }}</div>{% endif %}
      <div class="leaderboard-grid"><div class="leaderboard-me"><span class="kicker">YOUR SNAPSHOT</span><div class="leader-metrics"><div><span>RANK</span><strong>{% if leaderboard.current and leaderboard.current.rank %}#{{ leaderboard.current.rank }}{% else %}—{% endif %}</strong></div><div><span>PAPER ROI</span><strong>{% if leaderboard.current %}{{ '%.1f'|format(leaderboard.current.roi*100) }}%{% else %}—{% endif %}</strong></div><div><span>WIN RATE</span><strong>{% if leaderboard.current %}{{ '%.1f'|format(leaderboard.current.win_rate*100) }}%{% else %}—{% endif %}</strong></div><div><span>TRADES</span><strong>{{ leaderboard.current.trades if leaderboard.current else 0 }}</strong></div></div><form method="post" action="/account/leaderboard" class="leader-form"><label>Public name<input class="text-input" name="leaderboard_name" maxlength="20" value="{{ user.leaderboard_name or '' }}" placeholder="Example: CarsonMP"></label><label class="opt-in-row"><input type="checkbox" name="leaderboard_opt_in" {% if user.leaderboard_opt_in %}checked{% endif %}><span>Show me on the public leaderboard</span></label><button class="btn btn-secondary" type="submit">Save ranking settings</button></form><small class="muted">Opt in and complete 1 settled paper trade to receive a public rank.</small></div>
        <div class="leaderboard-table"><div class="leaderboard-title"><strong>Top pilots</strong><span>Community leaderboard</span></div><table><thead><tr><th>#</th><th>Pilot</th><th>ROI</th><th>Win %</th><th>Trades</th></tr></thead><tbody>{% for item in leaderboard.top %}<tr {% if item.user_id==user.id %}class="me-row"{% endif %}><td>{{ item.rank }}</td><td>{{ item.name }}</td><td class="{% if item.roi>=0 %}positive{% else %}negative{% endif %}">{{ '%.1f'|format(item.roi*100) }}%</td><td>{{ '%.1f'|format(item.win_rate*100) }}%</td><td>{{ item.trades }}</td></tr>{% else %}<tr><td colspan="5" class="muted">No ranked members yet.</td></tr>{% endfor %}</tbody></table>{% if leaderboard.demo_mode %}<p class="leaderboard-disclosure">Sample leaderboard rows are illustrative until enough real members opt in. Real member results replace them automatically.</p>{% endif %}</div></div>
    </section>
  </div>
</main>
<script src="{{ url_for('static', filename='tabs.js') }}"></script>
{% if access %}<script type="module" src="{{ url_for('static', filename='account.js') }}"></script>{% endif %}
{% endblock %}

{% extends "base.html" %}{% block title %}Create account · MarketPilot{% endblock %}{% block body %}<main class="gate-shell"><a class="brand" href="/"><span class="brand-mark">M</span><span>MarketPilot</span></a><section class="gate-card"><span class="kicker">CREATE ACCOUNT</span><h1>Your MarketPilot account.</h1><p>One login for your trial, purchase, and Polymarket connection.</p>{% if error %}<div class="notice error">{{ error }}</div>{% endif %}<form class="auth-form" method="post"><label>Email<input class="text-input" type="email" name="email" required></label><label>Password<input class="text-input" type="password" name="password" minlength="8" required></label><button class="btn btn-primary btn-wide" type="submit">Create account</button></form><a class="text-link" href="/login{% if next %}?next={{ next }}{% endif %}">Already have an account? Sign in</a></section></main>{% endblock %}
{% extends "base.html" %}
{% block title %}MarketPilot · BTC 5M Tool{% endblock %}
{% block body %}
<div id="toolRoot" class="tool-shell" data-access-kind="{{ access_kind }}">
  {% if access_kind == "trial" %}<div class="trial-buy-bar"><span>Free trial active.</span><a href="/purchase">Unlock MarketPilot for {{ price }}</a></div>{% endif %}

  <header class="tool-header compact-header">
    <a class="brand" href="/"><span class="brand-mark">M</span><span>MarketPilot</span></a>
    <div class="header-right">
      <button id="helpOpen" class="header-link ghost-button" type="button">Help & AI</button>
      <a class="header-link" href="/account">My Account</a>
      {% if access_kind == "trial" %}<a class="btn btn-primary btn-small" href="/purchase">Unlock · {{ price }}</a>{% endif %}
      <button id="soundToggle" class="sound-toggle" type="button" aria-pressed="false">Sound: Off</button>
      <span id="accessBadge" class="access-badge"></span>
      <span class="live-badge">● LIVE</span>
    </div>
  </header>

  <nav class="section-tabs" data-tab-group="tool" aria-label="MarketPilot sections">
    <button class="section-tab active" type="button" data-tab-target="trade">Trade</button>
    <button class="section-tab" type="button" data-tab-target="performance">Performance</button>
    <button class="section-tab" type="button" data-tab-target="rules">Rules & Bankroll</button>
  </nav>

  <div class="tab-pane active" data-tab-pane="trade">
    <section class="decision-grid">
      <article class="panel decision-panel">
        <span class="kicker">CURRENT BTC 5-MINUTE DECISION</span>
        <h1 id="decisionState" class="decision-state wait">WAIT</h1>
        <p id="decisionReason" class="muted">Waiting for market data…</p>
        <div class="decision-meta"><span id="decisionBadge" class="state-badge">SCANNING</span><span id="sessionLabel" class="mini-label">—</span></div>
        <div class="confirm-track"><span id="confirmFill"></span></div>
        <small id="confirmText" class="muted">0 / 2 confirmations</small>
      </article>
      <article class="panel timer-panel">
        <span class="kicker">MARKET CLOSES IN</span>
        <div id="marketTimer" class="market-timer">--:--</div>
        <div class="timer-track"><span id="timerFill"></span></div>
      </article>
    </section>

    <section class="metric-grid compact-metrics">
      <div class="metric"><span>BTC LIVE</span><strong id="btcLive">—</strong><small>Coinbase live feed</small></div>
      <div class="metric target-metric"><span>PRICE TO BEAT</span><strong id="targetPrice">—</strong><small>Resets each round</small></div>
      <div class="metric"><span>UP</span><strong id="upPrice">—</strong><small>Executable ask</small></div>
      <div class="metric"><span>DOWN</span><strong id="downPrice">—</strong><small>Executable ask</small></div>
    </section>

    <section class="panel entry-panel compact-entry">
      <div>
        <span class="kicker">ENTRY ZONE</span>
        <h2 id="entryTitle">Waiting for market…</h2>
      </div>
      <div class="entry-layout">
        <div class="entry-zone"><span id="entrySideLabel">MAX BUY PRICE</span><strong id="maxBuy">—</strong><small id="entryStatus">WAITING</small></div>
        <div class="mini-grid">
          <div><span>FAIR PROB.</span><strong id="fairProb">—</strong></div>
          <div><span>EDGE</span><strong id="edgeValue">—</strong></div>
          <div><span>CHART</span><strong id="chartRead">—</strong></div>
          <div><span>BOOK</span><strong id="bookPressure">—</strong></div>
        </div>
      </div>
    </section>

    <section class="panel chart-panel">
      <div class="panel-heading"><div><span class="kicker">LIVE BTC VS PRICE TO BEAT</span><h2>Bitcoin · live trades</h2></div><span id="wsStatus" class="ws-status">CONNECTING</span></div>
      <div id="chartWrap" class="chart-wrap"><canvas id="btcChart"></canvas><div id="chartPrice" class="chart-price">BTC —</div></div>
    </section>

    <section class="panel account-connect-panel account-connect-hero compact-connect-hero">
      <div class="connect-hero-copy"><span class="connect-live-dot">● CONNECT YOUR ACCOUNT</span><h2>Trade-ready Polymarket connection</h2><p>Authorize a scoped trading-only connection from My Account. No withdrawal permission.</p></div>
      <div class="connect-hero-action"><a class="btn btn-primary connect-big" href="/account#polymarket">Connect Polymarket</a><small>Manage or revoke anytime.</small></div>
    </section>
  </div>

  <div class="tab-pane" data-tab-pane="performance">
    <section class="panel performance-summary">
      <div class="panel-heading"><div><span class="kicker">PERFORMANCE</span><h2>Paper results at a glance</h2></div></div>
      <div class="metric-grid stats-grid">
        <div class="metric"><span>PAPER P&L</span><strong id="paperPnl">—</strong></div>
        <div class="metric"><span>WIN RATE</span><strong id="winRate">—</strong></div>
        <div class="metric"><span>STREAK</span><strong id="winStreak">—</strong></div>
        <div class="metric"><span>SETTLED</span><strong id="settledTrades">—</strong></div>
        <div class="metric"><span>TRADE FREQUENCY</span><strong id="tradeFrequency">—</strong><small id="roundsObserved">— rounds observed</small></div>
      </div>
    </section>
    <section class="panel trades-panel">
      <div class="panel-heading"><div><span class="kicker">RECENT CONFIRMED TRADES</span><h2>Newest first</h2></div></div>
      <div class="table-wrap"><table><thead><tr><th>Time</th><th>Side</th><th>Entry</th><th>Model</th><th>Edge</th><th>Status</th><th>P&L</th></tr></thead><tbody id="tradeRows"><tr><td colspan="7" class="muted">No trades yet.</td></tr></tbody></table></div>
    </section>
  </div>

  <div class="tab-pane" data-tab-pane="rules">
    <section id="rules" class="panel rules-panel simplified-rules">
      <div class="panel-heading"><div><span class="kicker">HOW MARKETPILOT WORKS</span><h2>Four rules to keep it simple</h2></div><span class="mini-label">BTC 5M ONLY</span></div>
      <div class="rules-grid">
        <article><span class="rule-num">01</span><h3>Wait for confirmation</h3><p>A lean is not a trade. Use confirmed BUY signals only.</p></article>
        <article><span class="rule-num">02</span><h3>Do not chase</h3><p>If the ask is above the max buy price, the estimated edge is gone.</p></article>
        <article><span class="rule-num">03</span><h3>One round, one position</h3><p>No martingale or doubling down after a loss.</p></article>
        <article><span class="rule-num">04</span><h3>Respect the daily stop</h3><p>Protect the bankroll before increasing size.</p></article>
      </div>
      <div class="bankroll-planner compact-planner">
        <div><span class="kicker">BANKROLL PLAN</span><h3>Aggressive bankroll profile.</h3><p class="muted">Enter the bankroll set aside for this strategy. Higher sizing increases both gains and losses.</p></div>
        <div class="planner-controls"><label for="bankrollInput">Trading bankroll</label><div class="money-input"><span>$</span><input id="bankrollInput" type="number" inputmode="decimal" min="25" max="1000000" step="25" value="1000" /></div></div>
        <div class="planner-output">
          <div><span>RISK / TRADE</span><strong id="planRisk">—</strong><small>1.00%</small></div>
          <div><span>DAILY STOP</span><strong id="planStop">—</strong><small>5%</small></div>
          <div><span>MAX OPEN</span><strong id="planOpen">—</strong><small>2%</small></div>
          <div><span>RESERVE</span><strong id="planReserve">—</strong><small>80%</small></div>
        </div>
      </div>
    </section>
  </div>

  <button id="helpFloat" class="help-float" type="button">? Help & AI</button>
  <aside id="helpDrawer" class="help-drawer" aria-hidden="true">
    <div class="help-head"><div><span class="kicker">MARKETPILOT HELP</span><h2>Help & Ask AI</h2></div><button id="helpClose" class="drawer-close" type="button" aria-label="Close help">×</button></div>
    <div class="help-quick"><button type="button" data-help-q="What does estimated edge mean?">What is edge?</button><button type="button" data-help-q="How does max buy price work?">Max buy price</button><button type="button" data-help-q="What is price to beat?">Price to beat</button><button type="button" data-help-q="How do the sounds work?">Sound cues</button><button type="button" data-help-q="How do I connect Polymarket safely?">Connect account</button></div>
    <div id="helpAnswer" class="help-answer">Ask about the current signal or any MarketPilot feature.</div>
    <form id="aiForm" class="ai-form"><label for="aiQuestion">Ask MarketPilot AI</label><textarea id="aiQuestion" maxlength="700" rows="3" placeholder="Example: Why is MarketPilot waiting right now?"></textarea><button class="btn btn-primary btn-wide" type="submit">Ask AI</button><small>AI explains the tool and current metrics. It does not guarantee outcomes.</small></form>
  </aside>
  <div id="helpBackdrop" class="help-backdrop" hidden></div>
  <div id="crossToast" class="cross-toast" aria-live="polite"></div>
  <p class="disclaimer">MarketPilot is a research/trading tool. Model probabilities are estimates, not guarantees. Trading decisions remain yours.</p>
</div>
<script src="{{ url_for('static', filename='tabs.js') }}"></script>
<script src="{{ url_for('static', filename='tool.js') }}"></script>
{% endblock %}

